# --- Gemini (pick ONE) -------------------------------------------------------
# Option A: Google AI Studio key (local dev)
GEMINI_API_KEY=
# Option B: Vertex AI (Cloud Run uses the service account, no key needed)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=asia-southeast1
# Model name is configurable; use any Gemini model available to your project.
GEMINI_MODEL=gemini-2.5-flash
# Delay (s) between streamed simulation results, purely so the UI animation is readable
STREAM_PACE_SECONDS=0.45
